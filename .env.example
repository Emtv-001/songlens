PORT=5000
NODE_ENV=development
MONGODB_URI=your_atlas_connection_string_here
JWT_SECRET=a_long_random_string
JWT_EXPIRES_IN=7d

# Optional
# Separate secret for signing audio links (defaults to JWT_SECRET)
AUDIO_URL_SECRET=
# Maximum audio upload size in megabytes (default 50)
AUDIO_MAX_MB=50
# Where audio is stored: "local" is the only driver so far
STORAGE_DRIVER=local
# Folder for local audio storage (default: ./storage)
LOCAL_STORAGE_DIR=
# S3-compatible storage (only needed when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
